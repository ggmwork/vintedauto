{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "isolatedModules": false,
    "lib": ["es2022", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "target": "es2022",
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "lib/intake/stock-item-names.ts",
    "lib/vinted/listing-profile.ts",
    "lib/vinted/handoff.ts",
    "lib/vinted/extension-cors.ts",
    "lib/drafts/draft-readiness.ts",
    "lib/ai/local-cli-command-runner.ts",
    "lib/ai/local-cli-codex.ts",
    "lib/ai/local-cli-output.ts",
    "lib/ai/local-model-discovery.ts",
    "lib/ai/listing-generation-shared.ts",
    "lib/data/database-root.ts",
    "lib/data/json-store.ts",
    "lib/listing-generation-jobs.ts",
    "lib/data-portability/database-archive.ts",
    "lib/data-portability/zip-archive.ts",
    "types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".test-build"]
}
